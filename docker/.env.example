# Required: choose a long, random secret and keep it private.
MEMEX_API_TOKEN=replace-with-a-long-random-secret

# Optional settings (defaults shown).
MEMEX_PORT=8000
MEMEX_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
MEMEX_DEVICE=auto
MEMEX_QDRANT_MODE=embedded
# Used only when MEMEX_QDRANT_MODE=server. Point to a reachable Qdrant service.
MEMEX_QDRANT_URL=http://qdrant:6333
MEMEX_COLLECTION=memex
MEMEX_CHUNK_TOKENS=512
MEMEX_CHUNK_OVERLAP=64
